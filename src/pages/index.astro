---
import '../styles/app.css'
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Marcos Arrieta</title>

    {/* Before any stylesheet: settles the theme on the first paint. */}
    <script is:inline>
      ;(function () {
        let t = localStorage.getItem('theme')
        if (t !== 'light' && t !== 'dark')
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        const r = document.documentElement
        r.style.colorScheme = t
        r.dataset.theme = t
        r.classList.add('has-js')
      })()
    </script>

    <link rel="preload" as="font" type="font/woff2" href="/fonts/manrope-var.woff2" crossorigin />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/ibm-plex-mono-400.woff2"
      crossorigin
    />
  </head>
  <body>
    <!-- Token test bench; issue 02 replaces this page. -->
    <main class="mx-auto max-w-[1200px] px-[clamp(20px,4vw,48px)] py-16">
      <p class="font-mono text-label text-dim uppercase">00 / tokens</p>
      <h1 class="text-h1 font-sans">
        Marcos Arrieta<br /><span class="text-accent">portfolio v3</span>
      </h1>
      <p class="text-hero-sub text-dim mt-6">Latin subset: ñ á é í ó ú ü ¿? ¡!</p>
      <div
        class="border-line bg-surface mt-10 rounded-3xl border p-6"
        style="border-color: color-mix(in srgb, var(--color-accent) 45%, transparent)"
      >
        <p class="text-body">Surface on <code class="font-mono">--color-surface</code>.</p>
      </div>
      <ul class="mt-10 flex gap-3">
        <li class="bg-step-1 size-4 rounded-full"></li>
        <li class="bg-step-2 size-4 rounded-full"></li>
        <li class="bg-step-3 size-4 rounded-full"></li>
        <li class="bg-step-4 size-4 rounded-full"></li>
        <li class="bg-step-5 size-4 rounded-full"></li>
      </ul>
    </main>
  </body>
</html>
