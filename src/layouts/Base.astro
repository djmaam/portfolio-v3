---
import '../styles/app.css'
import { content, links, site } from '../lib/content'
import type { Lang } from '../lib/content'
import { siblingPath } from '../lib/i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const otherLang: Lang = lang === 'es' ? 'en' : 'es'
const t = content[lang]

// `siblingPath(path, lang)` normalizes the current route too, so it yields both the
// canonical URL of this page and the href of its translation.
const canonical = `${links.domain}${siblingPath(Astro.url.pathname, lang)}`
const siblingHref = siblingPath(Astro.url.pathname, otherLang)
const ogLocale = lang === 'es' ? 'es_AR' : 'en_US'
const title = `${site.name} · ${t.eyebrow}`
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={t.heroSub} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="es" href={`${links.domain}/`} />
    <link rel="alternate" hreflang="en" href={`${links.domain}/en`} />
    <link rel="alternate" hreflang="x-default" href={`${links.domain}/`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={t.heroSub} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    {/* Shipped ahead of the file: `public/og.png` arrives with the deploy issue. */}
    <meta property="og:image" content={`${links.domain}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Before any stylesheet: settles the theme and the language on the first paint. */}
    <script is:inline define:vars={{ otherLang, siblingHref }}>
      ;(function () {
        let t = localStorage.getItem('theme')
        if (t !== 'light' && t !== 'dark')
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        const r = document.documentElement
        r.style.colorScheme = t
        r.dataset.theme = t
        r.classList.add('has-js')

        // At most one language redirect per session, and `replace` so the wrong-language
        // page never enters the back-button history. The toggle writes `lang` before it
        // navigates, so an explicit choice always agrees with the route it lands on.
        if (
          localStorage.getItem('lang') === otherLang &&
          !sessionStorage.getItem('langRedirected')
        ) {
          sessionStorage.setItem('langRedirected', '1')
          location.replace(siblingHref)
        }
      })()
    </script>

    <link rel="preload" as="font" type="font/woff2" href="/fonts/manrope-var.woff2" crossorigin />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/ibm-plex-mono-400.woff2"
      crossorigin
    />
  </head>
  <body>
    <div class="aurora" aria-hidden="true">
      <div></div>
      <div></div>
      <div></div>
    </div>

    {/* Everything readable sits above the aurora, which owns z-index 0 alone. */}
    <div class="relative z-[1]">
      <slot name="nav" />
      <main><slot /></main>
      <slot name="footer" />
    </div>

    <script>
      import { bindAnchors } from '../lib/motion/anchors'
      import { auroraStyle } from '../lib/motion/math'
      import { onScroll } from '../lib/motion/scroll'

      // Delegated on document, so it also covers the links every later issue adds.
      bindAnchors()

      const aurora = document.querySelector<HTMLElement>('.aurora')
      if (aurora) {
        onScroll(({ progress }) => {
          const { filter, opacity, translateY } = auroraStyle(progress)
          aurora.style.filter = filter
          aurora.style.opacity = String(opacity)
          aurora.style.transform = `translateY(${translateY})`
        })
      }

      // The language toggle is a real link; this only records the explicit choice before
      // leaving, which is what keeps the redirect in <head> from fighting the user.
      const toggle = document.querySelector<HTMLAnchorElement>('a[data-lang-toggle]')
      const target = toggle?.dataset.langToggle
      if (toggle && target) {
        toggle.addEventListener('click', () => localStorage.setItem('lang', target))
      }
    </script>
  </body>
</html>
