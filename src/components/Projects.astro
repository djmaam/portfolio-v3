---
import { existsSync } from 'node:fs'
import { join } from 'node:path'

import { content } from '../lib/content'
import type { Lang } from '../lib/content'
import { previewMode, projectDelay, projectUrl } from '../lib/projects'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = content[lang]

const projects = t.projects.map((project, index) => {
  const shot = `/previews/${project.host}.jpg`
  return {
    ...project,
    delay: projectDelay(index),
    // Resolved at build time: an <img> pointing at a file that is not there renders a
    // broken icon in every browser, so a project whose screenshot has not been captured
    // yet gets no <img> at all and the striped placeholder of the box shows through.
    shot:
      previewMode(project.host) === 'screenshot' && existsSync(join(process.cwd(), 'public', shot))
        ? shot
        : null,
  }
})
---

<section id="projects" class="section-y section-divider" aria-labelledby="projects-title">
  <div class="container-page">
    <div class="head" data-reveal>
      <div class="heading">
        <p class="font-mono text-label text-dim">04 / {t.secProjects}</p>
        <h2 id="projects-title" class="text-h2">{t.projectsTitle}</h2>
      </div>
      <p class="sub text-dim">{t.projectsSub}</p>
    </div>

    <ul class="cards">
      {
        /* The reveal goes on the `<li>`, one level above the hover transform of the
        card: two transforms on one element fight (`MOTION_SPEC` §5). */
      }
      {
        projects.map((project) => (
          <li data-reveal data-delay={project.delay}>
            <a
              class="card"
              href={projectUrl(project.host, project.url)}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="preview">
                {/* Decoration, not content: `alt=""` keeps it out of the accessibility
                tree, and it is a static file, so the card costs one same-origin request
                instead of the 40-50 third-party ones a live iframe of someone else's
                site drags in (spec 17). */}
                {project.shot && <img class="frame" src={project.shot} alt="" loading="lazy" />}
                <span class="shimmer" aria-hidden="true" />
                <span class="kind font-mono text-label-sm">{project.kind}</span>
              </div>

              <div class="meta">
                <span class="names">
                  <span class="text-card-title">{project.name}</span>
                  <span class="desc text-dim">{project.desc}</span>
                </span>
                <span class="arrow font-mono" aria-hidden="true">
                  ↗
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 40px;
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .sub {
    max-width: 380px;
    font-size: 16px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 14px;
  }

  .cards > li {
    display: flex;
    min-width: 0;
  }

  .card {
    display: flex;
    flex: 1;
    flex-direction: column;
    border-radius: 24px;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.25s,
      box-shadow 0.25s;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    box-shadow: 0 20px 60px var(--color-shadow-card);
  }

  /* The 4px lift of `DESIGN_SPEC` §4 is motion: with `reduce` the card still lights up
     on hover, it just stays where it is. */
  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition:
        transform 0.25s,
        border-color 0.25s,
        box-shadow 0.25s;
    }

    .card:hover {
      transform: translateY(-4px);
    }
  }

  /* The striped placeholder: it is the floor of every preview, so a screenshot that has
     not arrived yet leaves the box looking deliberate instead of empty. */
  .preview {
    position: relative;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: repeating-linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-ink) 4%, transparent) 0 6px,
      transparent 6px 14px
    );
  }

  /* The screenshot is captured at the same 16:11 as the box, so `cover` only ever has
     rounding to absorb. */
  .frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* Rest state matches the animation's `from` keyframe (`app.css`): offscreen-left,
     whether or not the animation is running. `left: -40%` used to double-count the
     offset and land the travelling band parked on the frame's right edge (PV3-29). */
  .shimmer {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 40%;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--color-accent) 12%, transparent),
      transparent
    );
    transform: translateX(-120%) skewX(-12deg);
  }

  .kind {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--color-glass);
    color: var(--color-accent);
    /* 10-11px, so the accent needs weight 500 to be legal as text (`DESIGN_SPEC` §6). */
    font-weight: 500;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
  }

  .meta {
    display: flex;
    flex: 1;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 16px 20px 18px;
  }

  .names {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .desc {
    font-size: 14px;
  }

  .arrow {
    flex: none;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .shimmer {
      animation: shimmer 2.8s ease-in-out infinite;
    }
  }
</style>
