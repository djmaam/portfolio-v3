---
import Console from './Console.astro'
import { content } from '../lib/content'
import type { Lang } from '../lib/content'
import { stats } from '../lib/ui'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = content[lang]

// The numbers are facts in `ui.ts`, the labels are copy in `content.json`.
const figures = [
  { value: stats.years, label: t.statYears },
  { value: stats.products, label: t.statProducts },
  { value: stats.platforms, label: t.statPlatforms },
]
---

<section class="hero">
  {/* The canvas of the node network is appended here, as a direct child of the shell. */}
  <div class="columns container-page">
    <div class="column">
      <p class="eyebrow font-mono text-label" data-boot="0">
        <span class="rule" aria-hidden="true"></span>
        <span>
          {/* Server-rendered whole: the typing driver empties it, so with no JS it reads. */}
          <span data-typed>{t.eyebrow}</span><span class="cursor" aria-hidden="true"></span>
        </span>
      </p>

      <h1 class="text-h1" data-boot="1">
        {t.h1a}<br /><span class="accent">{t.h1b}</span>
      </h1>

      <p class="sub text-hero-sub text-dim" data-boot="2">{t.heroSub}</p>

      <div class="ctas" data-boot="3">
        <a class="cta primary" href="#work" data-nav-link>{t.ctaWork}</a>
        <a class="cta secondary" href="#contact" data-nav-link>{t.ctaContact}</a>
      </div>

      <p class="stats font-mono" data-boot="4">
        {
          figures.map(({ value, label }) => (
            <span>
              <b>{value}</b> {label}
            </span>
          ))
        }
      </p>
    </div>

    <Console />
  </div>
</section>

<style>
  /* Full width and its own stacking context: the canvas paints at z-index 0 above the
     fixed aurora, the columns at z-index 1 above the canvas, and no z-index in the hero
     can reach past the section. */
  .hero {
    position: relative;
    isolation: isolate;
  }

  /* The only two-column grid with a 380px floor, and the only block with this vertical
     padding: both appear once in the site, so neither becomes a utility. */
  .columns {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(72px, 10vw, 140px) clamp(64px, 8vw, 110px);
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    text-transform: uppercase;
    color: var(--color-dim);
  }

  .rule {
    flex: none;
    width: 28px;
    height: 1px;
    background: var(--color-accent);
  }

  /* Its own element, so it blinks forever regardless of how far the typing got. */
  .cursor {
    display: inline-block;
    width: 7px;
    height: 12px;
    margin-left: 6px;
    vertical-align: -1px;
    background: var(--color-accent);
  }

  h1 {
    text-wrap: balance;
  }

  /* A one-off alpha pair, so it is mixed here instead of becoming a token (app.css §2).
     The weight is the h1's own, restated: the accent only clears the contrast threshold
     as text at ≥15px or weight ≥500 (`DESIGN_SPEC` §6), and this is the rule that says
     which of the two this one leans on. */
  .accent {
    color: var(--color-accent);
    font-weight: 600;
    text-shadow: 0 0 40px
      light-dark(
        color-mix(in srgb, var(--color-accent) 30%, transparent),
        color-mix(in srgb, var(--color-accent) 45%, transparent)
      );
  }

  .sub {
    max-width: 480px;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  .cta {
    padding: 14px 22px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    transition: border-color 0.2s;
  }

  .primary {
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .secondary {
    border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
    color: var(--color-ink);
  }

  .secondary:hover {
    border-color: var(--color-accent);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 10px;
    font-size: var(--text-label);
    white-space: nowrap;
    color: var(--color-dim);
  }

  .stats b {
    color: var(--color-ink);
    font-weight: 500;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1s steps(1) infinite;
    }

    /* The lift of `DESIGN_SPEC` §4 is motion like any other: with `reduce` the button
       still takes its hover border, it just does not move. */
    .cta {
      transition:
        transform 0.2s,
        border-color 0.2s;
    }

    .primary:hover {
      transform: translateY(-1px);
    }
  }
</style>

<script>
  import { boot } from '../lib/motion/boot'
  import { ENTRY_MS, entryDelay } from '../lib/motion/entry'
  import { mountEntry } from '../lib/motion/entryDriver'
  import { typedLength } from '../lib/motion/math'
  import { mountNetwork } from '../lib/motion/network'
  import { prefersReducedMotion } from '../lib/motion/reduced'

  const hero = document.querySelector<HTMLElement>('.hero')
  const card = document.querySelector<HTMLElement>('[data-console]')

  // Before `boot()`: the driver writes the `data-entry` flag the cascade reads to decide
  // whether it is timing an entry or catching up with one that already ran this session.
  if (card) mountEntry(card)
  boot()

  // The canvas is a direct child of the full-bleed shell and is measured against the
  // console card. `mountNetwork` creates nothing with `prefers-reduced-motion: reduce`.
  if (hero && card) mountNetwork(hero, card)

  const eyebrow = document.querySelector<HTMLElement>('[data-typed]')
  if (eyebrow && !prefersReducedMotion()) {
    const text = eyebrow.textContent ?? ''
    eyebrow.textContent = ''

    // rAF, not an interval: the wait is an offset on the elapsed time, so the typing stays
    // in step with the cascade instead of drifting past it. The eyebrow is `data-boot="0"`,
    // so it types as it is revealed — and immediately when the entry is not running.
    const wait = document.documentElement.dataset.entry === 'run' ? entryDelay(0, ENTRY_MS) : 0
    let start: number | undefined
    const step = (now: number) => {
      start ??= now
      const n = typedLength(now - start - wait, 28, text.length)
      eyebrow.textContent = text.slice(0, n)
      if (n < text.length) requestAnimationFrame(step)
    }
    requestAnimationFrame(step)
  }
</script>
